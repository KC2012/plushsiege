{
  "name": "plush-siege",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "validate": "node --import tsx scripts/validate.ts && npm run test:expansion",
    "test:browser": "node scripts/browser-test.mjs",
    "test:editor": "node scripts/editor-test.mjs",
    "test:offline": "node scripts/offline-test.mjs",
    "test:destruction": "node scripts/destruction-browser-test.mjs",
    "test:monsters": "node scripts/monster-browser-test.mjs",
    "test:presentation": "node scripts/presentation-browser-test.mjs",
    "test:camera": "node scripts/camera-browser-test.mjs",
    "test:audio": "node scripts/audio-browser-test.mjs",
    "test:expansion": "node --import tsx --test tests/expansion-content.test.ts",
    "produce:levels": "node --import tsx scripts/produce-levels.ts",
    "audit:expansion": "node --import tsx scripts/audit-expansion.ts",
    "test:worlds": "node scripts/expansion-browser-test.mjs",
    "test:showcase": "node scripts/showcase-browser-test.mjs",
    "measure:physics": "node --import tsx scripts/measure-campaign.ts",
    "measure:render": "node scripts/measure-render.mjs",
    "audit:siege": "node --import tsx scripts/audit-siege.ts",
    "test:siege": "node --import tsx --test tests/siege-content.test.ts",
    "test:siege-browser": "node scripts/siege-browser-test.mjs"
  },
  "dependencies": {
    "matter-js": "0.20.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/matter-js": "0.19.8",
    "@types/node": "22.15.30",
    "playwright": "1.57.0",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vite": "6.4.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
